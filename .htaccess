RewriteEngine On

RewriteRule ^product/?$ product/index.html [L]
RewriteRule ^cart/?$ cart/index.html [L]
RewriteRule ^checkout/?$ checkout/index.html [L]
RewriteRule ^order/?$ order/index.html [L]
RewriteRule ^shipping-rules/?$ shipping-rules/index.html [L]
RewriteRule ^refund-policy/?$ refund-policy/index.html [L]
RewriteRule ^privacy-policy/?$ privacy-policy/index.html [L]
RewriteRule ^cbd-sales-restrictions/?$ cbd-sales-restrictions/index.html [L]
RewriteRule ^account/?$ account/index.html [L]
RewriteRule ^account/login/?$ account/login/index.html [L]
RewriteRule ^account/register/?$ account/register/index.html [L]
RewriteRule ^admin/?$ admin/index.html [L]
RewriteRule ^admin/login/?$ admin/login/index.html [L]
RewriteRule ^admin/order/?$ admin/order/index.html [L]

RewriteRule ^api/quote$ api/quote.php [L]
RewriteRule ^api/orders/create$ api/orders-create.php [L]
RewriteRule ^api/orders/export$ api/orders-export.php [L]
RewriteRule ^api/account/register$ api/account-register.php [L]
RewriteRule ^api/account/login$ api/account-login.php [L]
RewriteRule ^api/account/logout$ api/account-logout.php [L]
RewriteRule ^api/account/session$ api/account-session.php [L]
RewriteRule ^api/account/update$ api/account-update.php [L]
RewriteRule ^api/account/orders$ api/account-orders.php [L]
RewriteRule ^api/newsletter/status$ api/newsletter-status.php [L]
RewriteRule ^api/newsletter/subscribe$ api/newsletter-subscribe.php [L]
RewriteRule ^api/admin/login$ api/admin-login.php [L]
RewriteRule ^api/admin/logout$ api/admin-logout.php [L]
RewriteRule ^api/admin/session$ api/admin-session.php [L]
RewriteRule ^api/admin/orders$ api/admin-orders-list.php [L]
RewriteRule ^api/admin/orders/([A-Za-z0-9-]+)/fulfillment$ api/admin-orders-fulfillment.php?id=$1 [L]
RewriteRule ^api/admin/orders/([A-Za-z0-9-]+)/emails/(customer|ops)/(mark-sent|requeue)$ api/admin-orders-email.php?id=$1&kind=$2&action=$3 [L]
RewriteRule ^api/admin/orders/([A-Za-z0-9-]+)$ api/admin-orders-get.php?id=$1 [L]
RewriteRule ^api/orders/([A-Za-z0-9-]+)$ api/orders-get.php?id=$1 [L]

RewriteRule ^product\.html$ product/ [R=301,L]
